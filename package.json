{
  "name": "vibesift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"magenta.bold,cyan.bold\" \"npm --prefix backend start\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend start",
    "setup": "npm install && npm --prefix backend install",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "cd backend && npm test",
    "test:lambda": "python backend/src/workers/python-inspector/test_lambda.py",
    "demo:lambda": "python backend/src/workers/python-inspector/lambda_function.py --test",
    "demo:inspect": "node backend/src/local-dev/inspect-run.js",
    "build:infra": "cd infra && npm run build",
    "synth:infra": "cd infra && npm run synth"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^5.0.5"
  }
}
